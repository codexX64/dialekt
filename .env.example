# Oracle : copier en .env, puis remplir. Chaque secret peut aussi venir d'un
# fichier : NOM_FILE=/chemin (convention des secrets Docker).

# Port publié sur l'hôte par docker-compose.yml.
ORACLE_PORT=8112

# Le modèle local (Ollama).
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:14b

# L'adversaire : claude-code, claude-api, openai, kimi, mistral, deepseek,
# gemini, groq, openrouter ou compatible. Sans clé ni jeton : local seul.
ADVERSAIRE=claude-code
ADVERSAIRE_CLE=
ADVERSAIRE_MODELE=
ADVERSAIRE_URL=
ADVERSAIRE_NOM=
# Pour claude-code : le jeton de « claude setup-token ».
CLAUDE_CODE_OAUTH_TOKEN=

# Comptes. SOCLE_CLE : 32 octets aléatoires en base64 (openssl rand -base64 32).
# Vide, Oracle en crée une dans son volume de données.
SOCLE_CLE=
# Pendant une rotation seulement : la clé remplacée (README, « Tourner une clé »).
SOCLE_CLE_ANCIENNE=
# 1 seulement sur un réseau de confiance sans HTTPS : pas de clé d'accès,
# mode dégradé affiché partout.
SOCLE_HTTP=0
# Relais inverses autorisés à transmettre l'adresse du client (CIDR).
SOCLE_PROXYS=
SOCLE_ORIGINES=
# Vide : Oracle en tire un au premier démarrage et l'écrit dans ses journaux.
SOCLE_JETON_INSTALLATION=

# Alertes de sécurité par courriel (facultatif). Sans relais, elles restent
# visibles dans la page Sécurité.
SOCLE_URL_PUBLIQUE=
SOCLE_SMTP_HOTE=
SOCLE_SMTP_PORT=
SOCLE_SMTP_SECURITE=tls
SOCLE_SMTP_UTILISATEUR=
SOCLE_SMTP_MOTDEPASSE=
SOCLE_SMTP_DE=

# Plafonds de dépense de l'adversaire, par compte.
ORACLE_DUELS_JOUR=200
ORACLE_DUELS_MINUTE=6
ORACLE_JETONS_MAX=8192
# Recherche web autorisée (0 : jamais, même si l'interface la demande).
ORACLE_RECHERCHE_WEB=1

# Hub et SYNAPSE (facultatifs).
ORACLE_HUB_TOKEN=
SYNAPSE_URL=
SYNAPSE_JETON=
MEMORY_URL=
MEMORY_API_KEY=
